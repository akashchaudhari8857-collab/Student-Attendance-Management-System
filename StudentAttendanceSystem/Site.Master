<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="StudentAttendanceSystem.Site" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title>Student Attendance Management System</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f5f6fa;
        }


        /* =========================
           HEADER
           ========================= */

        .header {
            background-color: #343a40;
            color: white;
            padding: 15px 25px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 21px;
            font-weight: bold;
        }

        .user-info {
            font-size: 14px;
        }


        /* =========================
           NAVIGATION
           ========================= */

        .navbar {
            background-color: #212529;
            padding: 0 25px;
        }

        .navbar a {
            display: inline-block;
            color: white;
            text-decoration: none;
            padding: 14px 18px;
        }

        .navbar a:hover {
            background-color: #495057;
        }


        /* =========================
           MAIN CONTENT
           ========================= */

        .main-content {
            width: 95%;
            margin: 25px auto;
        }


        /* =========================
           FOOTER
           ========================= */

        .footer {
            text-align: center;
            padding: 20px;
            margin-top: 30px;
            color: #666;
            font-size: 13px;
        }

    </style>
</head>
<body>
    <form id="form1" runat="server">
        <!-- HEADER -->

    <div class="header">
        <div class="logo">
            Student Attendance Management System
        </div>
        <div class="user-info">
            Welcome, <asp:Label ID="lblUserName" runat="server"></asp:Label>
        </div>
    </div>


    <!-- NAVIGATION -->

    <div class="navbar">


        <!-- Admin Navigation -->

        <asp:PlaceHolder
            ID="phAdminMenu"
            runat="server">

            <asp:HyperLink
        ID="lnkAdminDashboard"
        runat="server"
        NavigateUrl="~/Admin/Dashboard.aspx"
        Text="Dashboard">
    </asp:HyperLink>

    <asp:HyperLink
        ID="lnkClasses"
        runat="server"
        NavigateUrl="~/Admin/Classes.aspx"
        Text="Classes">
    </asp:HyperLink>

    <asp:HyperLink
        ID="lnkSubjects"
        runat="server"
        NavigateUrl="~/Admin/Subjects.aspx"
        Text="Subjects">
    </asp:HyperLink>

    <asp:HyperLink
        ID="lnkStudents"
        runat="server"
        NavigateUrl="~/Admin/Students.aspx"
        Text="Students">
    </asp:HyperLink>

    <asp:HyperLink
        ID="lnkMarkAttendance"
        runat="server"
        NavigateUrl="~/Admin/MarkAttendance.aspx"
        Text="Mark Attendance">
    </asp:HyperLink>

    <asp:HyperLink
        ID="lnkAttendanceReport"
        runat="server"
        NavigateUrl="~/Admin/AttendanceReport.aspx"
        Text="Attendance Report">
    </asp:HyperLink>

        </asp:PlaceHolder>


        <!-- Student Navigation -->

        <asp:PlaceHolder
            ID="phStudentMenu"
            runat="server">

            <asp:HyperLink
        ID="lnkStudentDashboard"
        runat="server"
        NavigateUrl="~/Student/Dashboard.aspx"
        Text="Dashboard">
    </asp:HyperLink>

        </asp:PlaceHolder>


        <!-- Logout -->

        <asp:HyperLink
    ID="lnkLogout"
    runat="server"
    NavigateUrl="~/Account/Logout.aspx"
    Text="Logout">
</asp:HyperLink>

    </div>


    <!-- MAIN CONTENT -->

    <div class="main-content">

        <asp:ContentPlaceHolder
            ID="MainContent"
            runat="server">
        </asp:ContentPlaceHolder>

    </div>


    <!-- FOOTER -->

    <div class="footer">

        Student Attendance Management System
        &copy; 2026

    </div>
    </form>
</body>
</html>
